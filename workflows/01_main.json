:\n    deadline = item[\"json\"]\n    if not deadline.get(\"title\"):\n        continue\n    line = f\"- {deadline['course']}: {deadline['title']}, due {deadline['due_pretty']} (in {deadline['days_left']} days)\"\n    if deadline.get(\"weight_pct\"):\n        line += f\", worth {deadline['weight_pct']}% of the grade\"\n    lines.append(line)\n\nif len(lines) == 0:\n    lines.append(\"(no open deadlines in the next 3 weeks)\")\n\nreturn [{\"json\": {\"list\": \"\\n\".join(lines)}}]"},"type":"n8n-nodes-base.code","typeVersion":2,"position":[240,560],"id":"adaf3495-697c-4d90-bce6-59188df370bd","name":"Describe deadlines"},{"parameters":{"promptType":"define","text":"=Today is {{ $now.setZone('Europe/Paris').toFormat('cccc d LLLL yyyy') }}.\nYou are a study coach for a university student. These are their open deadlines for the next 3 weeks:\n\n{{ $json.list }}\n\nWrite a realistic work plan for the next 7 days, starting today.\nRules:\n- One line per day: the day, then 1 or 2 tasks with an estimated time (e.g. \"~2h\").\n- The most urgent first, but give more time to deliverables worth a big part of the grade.\n- Never plan work on a deadline after its due date.\n- Plain text for Telegram: no tables, no ** or # symbols.\n- End with one short line warning about the busiest week ahead, if there is one.\n- 15 lines maximum.\n- If there are no deadlines, say so in one friendly sentence.","batching":{}},"type":"@n8n/n8n-nodes-langchain.chainLlm","typeVersion":1.9,"position":[464,560],"id":"ffe01f02-68e2-44d5-badb-957922fe4c6d","name":"Plan my week","retryOnFail":true,"waitBetweenTries":5000,"onError":"continueErrorOutput"},{"parameters":{"model":"nvidia/nemotron-3-ultra-550b-a55b:free","options":{}},"type":"@n8n/n8n-nodes-langchain.lmChatOpenRouter","typeVersion":1,"position":[464,736],"id":"f038390a-3b85-4d05-a8b1-fe095d5ef6f2","name":"OpenRouter Plan Model","credentials":{"openRouterApi":{"id":"cRCVkd0aRQrgRi0E","name":"OpenRouter account"}}},{"parameters":{"workflowId":{"