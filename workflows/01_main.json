8n/n8n-nodes-langchain.chainLlm","typeVersion":1.9,"position":[32,-288],"id":"8149df9f-ff3b-47d2-8a89-c939173837a8","name":"Extract Deadline","retryOnFail":true,"onError":"continueErrorOutput"},{"parameters":{"model":"nvidia/nemotron-3-ultra-550b-a55b:free","options":{}},"type":"@n8n/n8n-nodes-langchain.lmChatOpenRouter","typeVersion":1,"position":[32,-112],"id":"26e7edb2-08e0-4aaf-98e5-0247e085add4","name":"OpenRouter Chat Model","credentials":{"openRouterApi":{"id":"cRCVkd0aRQrgRi0E","name":"OpenRouter account"}}},{"parameters":{"jsonSchemaExample":"{ \n\"found\": true, \n\"course\": \"Computer Vision\", \n\"title\": \"Final project report\", \n\"due\": \"2026-10-28T20:00:00\",  \"weight_pct\": null \n}"},"type":"@n8n/n8n-nodes-langchain.outputParserStructured","typeVersion":1.3,"position":[176,-112],"id":"008ab59a-e12f-4cd0-97d5-020d10507d7f","name":"Structured Output Parser"},{"parameters":{"language":"pythonNative","pythonCode":"def is_real_date(text):\n    # the AI should answer like 2026-10-28T20:00:00\n    try:\n        date_part, time_part = text.split(\"T\")\n        year, month, day = [int(x) for x in date_part.split(\"-\")]\n        hour, minute = [int(x) for x in time_part.split(\":\")[:2]]\n    except (ValueError, AttributeError):\n        return False\n\n    february = 29 if year % 4 == 0 else 28\n    days_in_month = [31, february, 31, 30, 31, 30, 31, 31, 30, 31, 30, 31]\n\n    if not 1 <= month <= 12:\n        return False\n    return 1 <= day <= days_in_month[month - 1] and 0 <= hour <= 23 and 0 <= minute <= 59\n\n\nresults = []\n\nfor item in _items:\n    answer = item[\"json\"].get(\"output\", {})\n\n    found = answer.get(\"found\", False)\n    title = (answer.get(\"title\") or \"\").strip()\n    course = answer.get(\"course\") or \"Other\"\n    due = answer.get(\"due\") or \"\"\n\n    # the AI can invent a date, so check it is a real one\n    is_valid = found and title != \"\" and is_real_date(due)\n\n    results.append({\n        \"json\": {\n            \"valid\": is_valid,\n            \"course\": course,\n            \"title\": title,\n            \"dueAt\": due if is_valid else None,\n            \"weightPct\": answer.get(\"weight_pct\"),\n        }\n    })\n\nreturn results"},"type":"n8n-nodes-base.code","typeVersion":2,"position":[336,-288],"id":"6a32631e-7c3c-4f3c-bc25-831121285628","name":"Validate deadline"},{"parameters":{"operation":"executeQuery","query":"insert into deadlines (chat_id, course, title, due_at, weight_pct)\nvalues ($1, $2, $3, $4::timestamp at time zone 'Europe/Paris', $5)\nreturning id, course, title,\n          to_char(due_at at time zone 'Europe/Paris', 'Dy DD Mon, HH24:MI') as due_pretty;","options":{"queryReplacement":"={{ [ $('Parse message').item.json.chatId, $('Validate deadline').item.json.course, $('Validate deadline').item.json.title, $('Validate deadline').item.json.dueAt, $('Validate deadline').item.json.weightPct ] }}"}},"type":"n8n-nodes-base.postgres","typeVersion":2.7,"position":[1120,-160],"id":"f042cfe7-8b67-407f-860e-baeb600d7c6c","name":"Save Deadline","credentials":{"postgres":{"id":"Z1DNitHDdnd2Qa9m","name":"Postgres account"}}},{"parameters":{"workflowId":{"__rl":true,"value":"KoXYq5nYksmtxKoH","mode":"list","cachedResultUrl":"/workflow/KoXYq5nYksmtxKoH","cachedResultName":"Deadline Coach – Send to Telegram"},"workflowInputs":{"mappingMode":"defineBelow","value":{"chatId":"={{ $('Parse message').item.json.chatId }}","text":"=✅ Saved #{{ $json.id }}: {{ $json.title }} ({{ $json.course }}) 📅 Due {{ $json.due_pretty }}"},"matchingColumns":[],"schema":[{"id":"chatId","displayName":"chatId","required":false,"defaultMatch":false,"display":true,"canBeUsedToMatch":true,"type":"number"},{"id":"text","displayName":"text","required":false,"defaultMatch":false,"display":true,"canBeUsedToMatch":true,"type":"string"}],"attemptToConvertTypes":false,"convertFieldsToString":true},"options":{}},"type":"n8n-nodes-base.executeWorkflow","typeVersion":1.4,"position":[1296,-160],"id":"0114a1e8-bd18-4371-97cd-9fd501d1d34e","name":"Confirm saved"},{"parameters":{"workflowId":{"__rl":true,"value":"KoXYq5nYksmtxKoH","mode":"list","cachedResultUrl":"/workflow/KoXYq5nYksmtxKoH","cachedResultName":"Deadline Coach – Send to Telegram"},"workflowInputs":{"mappingMode":"defineBelow","value":{"chatId":"={{ $('Parse message').item.json.chatId }}","text":"🤔 I couldn't find a deadline with a date in that. Try: /add CV report 28/10 20:00"},"matchingColumns":[],"schema":[{"id":"chatId","displayName":"chatId","required":false,"defaultMatch":false,"display":true,"canBeUsedToMatch":true,"type":"number"},{"id":"text","displayName":"text","required":false,"defaultMatch":false,"display":true,"canBeUsedToMatch":true,"type":"string"}],"attemptToConvertTypes":false,"convertFieldsToString":true},"options":{}},"type":"n8n-nodes-base.executeWorkflow","typeVersion":1.4,"position":[720,-176],"id":"081f3860-c843-4594-beda-4b2f9cf4b5b7","name":"No deadline found"},{"parameters":{"language":"pythonNative","pythonCode":"COMMANDS = [\"help\", \"add\", \"deadlines\", \"done\", \"plan\", \"sync\"]\n\n\ndef looks_like(typed, command):\n    # same first letter and almost the same length, e.g. /dealines -> /deadlines\n    return typed[:1] == command[:1] and abs(len(typed) - len(command)) <= 2\n\n\nresults = []\n\nfor item in _items:\n    message = item[\"json\"].get(\"message\", {})\n    text = (message.get(\"text\") or \"\").strip()\n\n    command = \"unknown\"\n    args = \"\"\n    suggestion = None\n\n    if text.startswith(\"/\"):\n        # \"/add CV report 28/10\" -> word = \"add\", args = \"CV report 28/10\"\n        parts = text[1:].split(maxsplit=1)\n        word = parts[0].lower() if parts else \"\"\n        if len(parts) > 1:\n            args = parts[1]\n\n        # in groups Telegram adds the bot name: /help@my_bot\n        word = word.split(\"@\")[0]\n\n        if word == \"start\":\n            command = \"help\"\n        elif word in COMMANDS:\n            command = word\n        else:\n            for known in COMMANDS:\n                if looks_like(word, known):\n                    suggestion = \"/\" + known\n                    break\n\n    results.append({\n        \"json\": {\n            \"chatId\": message[\"chat\"][\"id\"],\n            \"firstName\": message.get(\"from\", {}).get(\"first_name\", \"\"),\n            \"command\": command,\n            \"args\": args,\n            \"suggestion\": suggestion,\n        }\n    })\n\nreturn results"},"type":"n8n-nodes-base.code","typeVersion":2,"position":[-544,-32],"id":"f4cf97f7-a8a6-4cd9-980a-2e65601a63f9","name":"Parse message"},{"parameters":{"operation":"executeQuery","query":"select id, course, title,\n       to_char(due_at at time zone 'Europe/Paris', 'Dy DD Mon, HH24:MI') as due_pretty,\n       (due_at at time zone 'Europe/Paris')::date\n         - (now() at time zone 'Europe/Paris')::date as days_left\nfrom deadlines\nwhere chat_id = $1 and status = 'open'\norder by due_at;","options":{"queryReplacement":"={{ [ $json.chatId ] }}"}},"type":"n8n-nodes-base.postgres","typeVersion":2.7,"position":[16,32],"id":"69ec229a-5430-494a-b3d5-29ffbd939075","name":"Get open deadlines","alwaysOutputData":true,"credentials":{"postgres":{"id":"Z1DNitHDdnd2Qa9m","name":"Postgres account"}}},{"parameters":{"language":"pythonNative","pythonCode":"def urgency(days_left):\n    if days_left < 0:\n        return \"⚫\", f\"{-days_left} days late\"\n    if days_left == 0:\n        return \"🔴\", \"today\"\n    if days_left == 1:\n        return \"🔴\", \"tomorrow\"\n    if days_left <= 3:\n        return \"🔴\", f\"in {days_left} days\"\n    if days_left <= 7:\n        return \"🟠\", f\"in {days_left} days\"\n    return \"🟢\", f\"in {days_left} days\"\n\n\n# \"Always Output Data\" sends one empty item when the table has no rows\ndeadlines = []\nfor item in _items:\n    if item[\"json\"].get(\"id\"):\n        deadlines.append(item[\"json\"])\n\nif len(deadlines) == 0:\n    return [{\"json\": {\"reply\": \"No open deadlines 🎉 Add one with /add\"}}]\n\nlines = []\nfor deadline in deadlines:\n    icon, when = urgency(deadline[\"days_left\"])\n    lines.append(f\"{icon} #{deadline['id']} {deadline['title']} ({deadline['course']})\")\n    lines.append(f\"      {deadline['due_pretty']} · {when}\")\n\nreply = f\"Open deadlines ({len(deadlines)})\\n\\n\" + \"\\n\".join(lines)\n\nreturn [{\"json\": {\"reply\": reply}}]"},"type":"n8n-nodes-base.code","typeVersion":2,"position":[192,32],"id":"66c246ce-f248-4a78-ac99-21e1e066d803","name":"Format list"},{"parameters":{"workflowId":{"__rl":true,"value":"KoXYq5nYksmtxKoH","mode":"list","cachedResultUrl":"/workflow/KoXYq5nYksmtxKoH","cachedResultName":"Deadline Coach – Send to Telegram"},"workflowInputs":{"mappingMode":"defineBelow","value":{"chatId":"={{ $('Parse message').item.json.chatId }}","text":"={{ $json.reply }}"},"matchingColumns":[],"schema":[{"id":"chatId","displayName":"chatId","required":false,"defaultMatch":false,"display":true,"canBeUsedToMatch":true,"type":"number"},{"id":"text","displayName":"text","required":false,"defaultMatch":false,"display":true,"canBeUsedToMatch":true,"type":"string"}],"attemptToConvertTypes":false,"convertFieldsToString":true},"options":{}},"type":"n8n-nodes-base.executeWorkflow","typeVersion":1.4,"position":[368,32],"id":"b21fcde5-f3b5-4b1b-82c6-7f1e936e0e5a","name":"Send list"},{"parameters":{"operation":"executeQuery","query":"update deadlines\nset status = 'done', updated_at = now()\nwhere chat_id = $1 and id = $2 and status = 'open'\nreturning id, title;","options":{"queryReplacement":"={{ [ $json.chatId, Number($json.args) || 0 ] }}"}},"type":"n8n-nodes-base.postgres","typeVersion":2.7,"position":[16,192],"id":"99ff57c8-4e2e-4fa1-b949-d72f3946dc34","name":"Mark done","alwaysOutputData":true,"credentials":{"postgres":{"id":"Z1DNitHDdnd2Qa9m","name":"Postgres account"}}},{"parameters":{"workflowId":{"__rl":true,"value":"KoXYq5nYksmtxKoH","mode":"list","cachedResultUrl":"/