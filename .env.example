# Copy this file to .env and fill in the values. Never commit .env.

# --- n8n ---
# Long random string; n8n uses it to encrypt the stored credentials.
# Generate one with:  openssl rand -hex 32
N8N_ENCRYPTION_KEY=change-me
N8N_HOST=localhost
N8N_PORT=5678
# Public HTTPS URL that reaches n8n (needed for the Telegram webhook),
# e.g. a Cloudflare Tunnel or ngrok URL.
WEBHOOK_URL=https://your-public-url.example.com/
GENERIC_TIMEZONE=Europe/Paris

# --- Postgres (n8n's own database + the project database) ---
POSTGRES_USER=n8n
POSTGRES_PASSWORD=change-me
POSTGRES_DB=n8n

# --- Values entered in n8n, not read from this file ---
# Telegram bot token        -> n8n credential "Telegram account"
# OpenRouter API key        -> n8n credential "OpenRouter account"
# Project database          -> n8n credential "Postgres account"
#                              (host: postgres, database: deadline_coach, same user/password as above)
# Moodle calendar export URL -> node "Get Moodle calendar" in 03_moodle_sync.json
MOODLE_CALENDAR_URL=https://moodle.example.com/calendar/export_execute.php?userid=...&authtoken=...
